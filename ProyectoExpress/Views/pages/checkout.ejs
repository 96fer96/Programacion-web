<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Checkout | MiEcommerce
    </title>


    <!-- CSS general del sitio -->
    <link
        rel="stylesheet"
        href="/css/styles.css"
    >


    <!-- CSS para dispositivos móviles -->
    <link
        rel="stylesheet"
        href="/css/mobile.css"
    >


    <!-- Font Awesome proporciona los íconos -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

</head>


<body>


    <!-- HEADER -->

    <%- include("../partials/header") %>



    <main class="checkout-page">


        <section class="checkout-card">


            <div class="checkout-icon">

                <i class="fa-solid fa-cart-shopping"></i>

            </div>


            <h1>
                Checkout
            </h1>


            <p>
                Checkout disponible en el próximo sprint
            </p>


            <div class="checkout-actions">


                <a
                    href="/cart"
                    class="checkout-button"
                >
                    Volver al carrito
                </a>


                <a
                    href="/"
                    class="checkout-button checkout-button-secondary"
                >
                    Volver al inicio
                </a>


            </div>


        </section>


    </main>


</body>

</html>