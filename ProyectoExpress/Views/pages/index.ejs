    <main>


        <!-- TÍTULO PRINCIPAL PARA ACCESIBILIDAD -->

        <h1 class="sr-only">
            Inicio de MiEcommerce
        </h1>



        <!-- =========================
            CATEGORÍAS SUPERIORES
        ========================= -->

        <section
            class="top-categories"
            aria-label="Categorías principales"
        >

            <%- include("../partials/categories") %>

        </section>



        <!-- =========================
     BENEFICIOS
     ========================= -->

        <section
            class="benefits-section"
            aria-labelledby="benefits-title"
        >

            <h2
                id="benefits-title"
                class="sr-only"
            >
                Beneficios y promociones
            </h2>

            <div class="benefits-container">

                <a
                    href="#"
                    class="benefit-card"
                    aria-label="Ver beneficio promocional 1"
                >
                    <img
                        src="/img/benefits/beneficio1.jpg"
                        alt="Beneficio promocional de MiEcommerce"
                    >
                </a>


                <a
                    href="#"
                    class="benefit-card"
                    aria-label="Ver beneficio promocional 2"
                >
                    <img
                        src="/img/benefits/beneficio2.jpg"
                        alt="Segundo beneficio promocional de MiEcommerce"
                    >
                </a>

            </div>

        </section>
        <!-- =========================
            PRODUCTOS MAS PEDIDOS
            ========================= -->

        <section
            class="products-section"
            aria-labelledby="products-title"
        >

            <h2 id="products-title">
                Mas pedidos
            </h2>


            <ul class="products-grid">

                <!-- Se copian a un nuevo arreglo los 10 productos con mayor cantidad de pedidos-->
                <%
                    const masPedidos =
                        [...products]
                            .sort((a, b) => b.pedidos - a.pedidos)
                            .slice(0, 10);

                    masPedidos.forEach(product => {
                %>

                    <li>

                        <a
                            href="/products/<%= product.id %>"
                            class="product-card"
                        >

                            <div class="product-image-container">

                                <img
                                    src="<%= product.image %>"
                                    alt="Imagen de <%= product.name %>"
                                >

                            </div>


                            <div class="product-info">

                                <h3>
                                    <%= product.name %>
                                </h3>

                                <p class="product-description">
                                    <%= product.description %>
                                </p>

                                <p class="product-price">
                                    $<%= product.price %>
                                </p>

                            </div>

                        </a>

                    </li>

                <% }) %>

            </ul>

        </section>

        <!-- =========================
            PRODUCTOS RECOMENDADOS
        ========================= -->

        <section
            class="products-section"
            aria-labelledby="products-title"
        >

            <h2 id="products-title">
                Te puede interesar
            </h2>


            <ul class="products-grid">

                <!-- Se copian a un nuevo arreglo 5 productos aleatorios, para mostrarlos en la sección
                "Te puede interesar" -->
                <%  const sugeridos = [...products].sort(() => Math.random() - 0.5).slice(0, 5);
                    sugeridos.forEach(product => { 
                %>


                    <li>

                        <a
                            href="/products/<%= product.id %>"
                            class="product-card"
                        >


                            <img
                                src="<%= product.image %>"
                                alt="<%= product.name %>"
                            >


                            <div class="product-info">


                                <h3>
                                    <%= product.name %>
                                </h3>


                                <p class="product-price">
                                    $<%= product.price %>
                                </p>


                            </div>


                        </a>

                    </li>


                <% }) %>


            </ul>

        </section>



        <!-- =========================
             CATEGORÍAS INFERIORES
             ========================= -->

        <section
            class="bottom-categories"
            aria-label="Categorías principales"
        >

            <%- include("../partials/categories") %>

        </section>


    </main>