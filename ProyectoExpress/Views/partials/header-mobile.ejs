<!-- ==========================================
     HEADER PARA DISPOSITIVOS MÓVILES
=========================================== -->

<header class="mobile-header">

    <!-- =========================
         FILA SUPERIOR
    ========================== -->

    <div class="mobile-header-top">


        <!-- LOGO / MARCA -->

        <a
            href="/"
            class="mobile-brand"
            aria-label="MiEcommerce - Inicio"
        >
            MiEcommerce
        </a>



        <!-- SECCIÓN DE USUARIO -->

        <div class="mobile-user-section">


            <% if (currentUser) { %>


                <!-- NOMBRE DEL USUARIO -->

                <span class="mobile-username">
                    <%= currentUser.name %>
                </span>



                <!-- CERRAR SESIÓN -->

                <form
                    action="/logout"
                    method="POST"
                    class="mobile-logout-form"
                >

                    <button
                        type="submit"
                        class="mobile-logout-button"
                        aria-label="Cerrar sesión"
                    >
                        <i class="fa-solid fa-right-from-bracket"></i>
                    </button>

                </form>



                <!-- CARRITO -->

                <a
                    href="/cart"
                    class="mobile-cart"
                    aria-label="Ver carrito"
                >

                    <i class="fa-solid fa-cart-shopping"></i>


                    <% if (cartCount > 0) { %>

                        <span class="mobile-cart-count">
                            <%= cartCount %>
                        </span>

                    <% } %>


                </a>


            <% } else { %>


                <!-- INICIAR SESIÓN -->

                <a
                    href="/login"
                    class="mobile-login"
                    aria-label="Iniciar sesión"
                >

                    <i class="fa-solid fa-user"></i>

                </a>


            <% } %>


        </div>

    </div>



    <!-- =========================
         BUSCADOR
    ========================== -->

    <form
        class="mobile-search-form"
        action="/products"
        method="GET"
        role="search"
    >

        <label
            for="mobile-product-search"
            class="sr-only"
        >
            Buscar productos
        </label>


        <input
            type="search"
            id="mobile-product-search"
            name="q"
            placeholder="Buscar productos..."
        >


        <button
            type="submit"
            aria-label="Buscar"
        >

            <i class="fa-solid fa-magnifying-glass"></i>

        </button>

    </form>

</header>